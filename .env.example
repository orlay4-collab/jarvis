# =====================================================================
# .env.example : MODÈLE PUBLIC, SANS AUCUNE VALEUR
# =====================================================================
# Ce fichier peut être commité. Il liste les variables attendues.
# Pour l'utiliser : copier en .env (cp .env.example .env) puis
# renseigner les valeurs dans .env uniquement.
# Ne jamais mettre de vraie clé ici.
# =====================================================================

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Notion ---
NOTION_API_KEY=

# --- Google (Cloud, Maps, Drive, etc.) ---
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube Data API ---
YOUTUBE_API_KEY=

# --- Vercel ---
VERCEL_TOKEN=

# --- GitHub ---
GITHUB_TOKEN=

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
